{
  "name": "pgbloom",
  "version": "1.6.0",
  "description": "PGBloom is a PostgreSQL-first infrastructure toolkit for JavaScript and TypeScript providing caching, Pub/Sub, queues, distributed locks, leader election, scheduling, rate limiting, events, counters, Bloom filters, CRUD models, authentication, and OTP.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "pgbloom": "./dist/esm/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json",
    "./browser": {
      "types": "./dist/esm/browser.d.ts",
      "import": "./dist/esm/browser.js",
      "require": "./dist/cjs/browser.js",
      "default": "./dist/esm/browser.js"
    },
    "./server": {
      "types": "./dist/esm/server.d.ts",
      "import": "./dist/esm/server.js",
      "require": "./dist/cjs/server.js",
      "default": "./dist/esm/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:cjs:pkg && npm run build:cli",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:cjs:pkg": "node scripts/write-cjs-package-json.mjs",
    "build:cli": "tsc -p tsconfig.cli.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:bun": "bun test test/bun-smoke.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:esm": "node test/esm.test.mjs",
    "test:cjs": "node test/cjs.test.cjs",
    "test:integration": "vitest run test/integration-pg.test.ts",
    "test:integration:legacy": "node test/run-tests.js",
    "test:persistence": "node test/persistence-smoke.mjs",
    "test:docker": "node scripts/run-postgres-tests.mjs",
    "test:integration:load": "node test/load/load.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "cache",
    "pubsub",
    "queue",
    "bloom-filter",
    "nodejs",
    "typescript",
    "locks",
    "leader-election",
    "scheduler",
    "rate-limit",
    "events",
    "counters",
    "crud",
    "auth",
    "otp",
    "orm"
  ],
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "cac": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.5",
    "ssdiskdb": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^1.6.1",
    "express": "^5.2.1",
    "fastify": "^5.12.1",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Manoj Gowda <manojgowdain@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manojgowdain/pgsnap.git"
  },
  "bugs": {
    "url": "https://github.com/manojgowdain/pgsnap/issues"
  },
  "homepage": "https://github.com/manojgowdain/pgsnap#readme"
}
