{
  "name": "pgbloom",
  "version": "1.4.0",
  "description": "A lightweight PostgreSQL-backed Cache, Pub/Sub, Queue, Locks, Scheduler, Rate Limiting, Events, Counters and Bloom Filter library for Node.js",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:cjs:pkg",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:cjs:pkg": "node scripts/write-cjs-package-json.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:esm": "node test/esm.test.mjs",
    "test:cjs": "node test/cjs.test.cjs",
    "test:integration": "node test/run-tests.js",
    "test:integration:load": "node test/load/load.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "cache",
    "pubsub",
    "queue",
    "bloom-filter",
    "nodejs",
    "typescript",
    "locks",
    "leader-election",
    "scheduler",
    "rate-limit",
    "events",
    "counters"
  ],
  "dependencies": {
    "pg": "^8.11.5",
    "ssdiskdb": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.5",
    "express": "^5.2.1",
    "fastify": "^5.12.1",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Manoj Gowda <manojgowdain@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manojgowdain/pgsnap.git"
  },
  "bugs": {
    "url": "https://github.com/manojgowdain/pgsnap/issues"
  },
  "homepage": "https://github.com/manojgowdain/pgsnap#readme"
}
