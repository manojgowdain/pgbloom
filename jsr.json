{
  "name": "@manojgowdain/pgbloom",
  "version": "1.5.0",
  "license": "MIT",
  "description": "PGBloom is a PostgreSQL-first infrastructure toolkit for JavaScript and TypeScript providing caching, Pub/Sub, queues, distributed locks, leader election, scheduling, rate limiting, events, counters, and Bloom filters.",
  "homepage": "https://github.com/manojgowdain/pgbloom#readme",
  "repository": "https://github.com/manojgowdain/pgbloom",
  "bugs": "https://github.com/manojgowdain/pgbloom/issues",
  "keywords": [
    "postgres",
    "postgresql",
    "cache",
    "pubsub",
    "queue",
    "bloom-filter",
    "nodejs",
    "typescript",
    "locks",
    "leader-election",
    "scheduler",
    "rate-limit",
    "events",
    "counters"
  ],
  "exports": "./mod.ts",
  "include": [
    "src/**/*",
    "mod.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "docs",
    ".claude",
    "*.tgz",
    ".git",
    ".gitignore",
    "tsconfig*.json",
    "vitest.config.ts",
    "bun.lock",
    "package-lock.json"
  ],
  "publish": {
    "include": [
      "src/**/*",
      "mod.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "test",
      "docs",
      ".claude",
      "*.tgz",
      ".git",
      ".gitignore",
      "tsconfig*.json",
      "vitest.config.ts",
      "bun.lock",
      "package-lock.json"
    ]
  },
  "imports": {
    "@node-rs/argon2": "npm:@node-rs/argon2@^2.2.0",
    "cac": "npm:cac@^7.0.0",
    "crypto": "node:crypto",
    "jsonwebtoken": "npm:jsonwebtoken@^9.0.3",
    "pg": "npm:pg@^8.11.5",
    "ssdiskdb": "npm:ssdiskdb@^1.1.0"
  }
}